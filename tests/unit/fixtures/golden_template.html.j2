{%- macro render_list(items) -%}
<ul>
{%- for item in items %}
  <li>{{ item }}</li>
{%- endfor %}
</ul>
{%- endmacro -%}
<!doctype html>
<html>
<head><title>{{ title }}</title></head>
<body>
<h1>{{ title }}</h1>
<p>{{ escaped_text }}</p>
<div>{{ trusted_html | safe }}</div>
{{ render_list(items) }}
</body>
</html>
